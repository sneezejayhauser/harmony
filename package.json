{
  "name": "harmony",
  "version": "0.1.0",
  "description": "BYOK agent harness routed over free LLM providers",
  "type": "module",
  "bin": {
    "harmony": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test:tool-parser": "npm run build && node scripts/test-tool-parser.mjs",
    "test:fake-stream": "npm run build && node scripts/test-fake-stream.mjs",
    "test:telemetry": "npm run build && node scripts/test-telemetry.mjs",
    "test:agent-runtime": "npm run build && node scripts/test-agent-runtime.mjs",
    "test:verification": "npm run build && node scripts/test-verification.mjs",
    "benchmark:report": "npm run build && node scripts/benchmark-report.mjs",
    "benchmark:tasks": "npm run build && node scripts/benchmark-tasks.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sneezejayhauser/harmony.git"
  },
  "homepage": "https://github.com/sneezejayhauser/harmony",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
